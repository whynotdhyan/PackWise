<Project>

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Product>PackWise</Product>
    <Company>Northstar Labs</Company>
    <Authors>Northstar Labs</Authors>
    <Copyright>Copyright © 2026 Northstar Labs</Copyright>
    <VersionPrefix>1.0.0</VersionPrefix>
    <RepositoryUrl>https://github.com/whynotdhyan/PackWise</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup>
    <SevenZipDir>$(RepoRoot)third_party\7zip\</SevenZipDir>
    <SevenZipDll>$(SevenZipDir)x64\7z.dll</SevenZipDll>
  </PropertyGroup>

</Project>
