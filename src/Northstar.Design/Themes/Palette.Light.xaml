<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <sys:Boolean x:Key="Theme.IsDark">False</sys:Boolean>

  <Color x:Key="Color.Window">#F2F4F6</Color>
  <Color x:Key="Color.Surface">#FFFFFF</Color>
  <Color x:Key="Color.SurfaceAlt">#F7F8FA</Color>
  <Color x:Key="Color.SurfaceRaised">#FFFFFF</Color>
  <Color x:Key="Color.Chrome">#EEF1F4</Color>
  <Color x:Key="Color.Border">#DCE1E6</Color>
  <Color x:Key="Color.BorderStrong">#C3CBD3</Color>
  <Color x:Key="Color.Divider">#E6EAEE</Color>
  <Color x:Key="Color.Text">#1A222B</Color>
  <Color x:Key="Color.TextSecondary">#56626E</Color>
  <Color x:Key="Color.TextTertiary">#8691A0</Color>
  <Color x:Key="Color.TextOnAccent">#FFFFFF</Color>
  <Color x:Key="Color.Accent">#0E8A87</Color>
  <Color x:Key="Color.AccentHover">#0B7976</Color>
  <Color x:Key="Color.AccentPressed">#096764</Color>
  <Color x:Key="Color.AccentSoft">#D5EFED</Color>
  <Color x:Key="Color.AccentSoftHover">#E6F5F4</Color>
  <Color x:Key="Color.AccentText">#0A6F6C</Color>
  <Color x:Key="Color.Hover">#EBEFF2</Color>
  <Color x:Key="Color.Pressed">#E1E6EB</Color>
  <Color x:Key="Color.SelectionInactive">#E4E9ED</Color>
  <Color x:Key="Color.Danger">#C93636</Color>
  <Color x:Key="Color.DangerSoft">#FCEBEB</Color>
  <Color x:Key="Color.Warning">#B86E00</Color>
  <Color x:Key="Color.WarningSoft">#FFF3DE</Color>
  <Color x:Key="Color.Success">#1B8F52</Color>
  <Color x:Key="Color.SuccessSoft">#E3F4EA</Color>
  <Color x:Key="Color.InfoSoft">#E7F1FB</Color>
  <Color x:Key="Color.Info">#2563B5</Color>
  <Color x:Key="Color.IconStroke">#3A4652</Color>
  <Color x:Key="Color.IconAccent">#0E8A87</Color>
  <Color x:Key="Color.Scrollbar">#B9C2CB</Color>
  <Color x:Key="Color.ScrollbarHover">#98A3AE</Color>
  <Color x:Key="Color.Shadow">#33000000</Color>
  <Color x:Key="Color.Overlay">#66000000</Color>
  <Color x:Key="Color.InputBackground">#FFFFFF</Color>
  <Color x:Key="Color.InputBorder">#CBD3DB</Color>
  <Color x:Key="Color.InputBorderHover">#A9B4BF</Color>

  <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
  <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
  <SolidColorBrush x:Key="Brush.Chrome" Color="{StaticResource Color.Chrome}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
  <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}" />
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
  <SolidColorBrush x:Key="Brush.TextOnAccent" Color="{StaticResource Color.TextOnAccent}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
  <SolidColorBrush x:Key="Brush.AccentSoftHover" Color="{StaticResource Color.AccentSoftHover}" />
  <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
  <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />
  <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource Color.Pressed}" />
  <SolidColorBrush x:Key="Brush.SelectionInactive" Color="{StaticResource Color.SelectionInactive}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.WarningSoft" Color="{StaticResource Color.WarningSoft}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />
  <SolidColorBrush x:Key="Brush.InfoSoft" Color="{StaticResource Color.InfoSoft}" />
  <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />
  <SolidColorBrush x:Key="Brush.IconStroke" Color="{StaticResource Color.IconStroke}" />
  <SolidColorBrush x:Key="Brush.IconAccent" Color="{StaticResource Color.IconAccent}" />
  <SolidColorBrush x:Key="Brush.Scrollbar" Color="{StaticResource Color.Scrollbar}" />
  <SolidColorBrush x:Key="Brush.ScrollbarHover" Color="{StaticResource Color.ScrollbarHover}" />
  <SolidColorBrush x:Key="Brush.Shadow" Color="{StaticResource Color.Shadow}" />
  <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}" />
  <SolidColorBrush x:Key="Brush.InputBackground" Color="{StaticResource Color.InputBackground}" />
  <SolidColorBrush x:Key="Brush.InputBorder" Color="{StaticResource Color.InputBorder}" />
  <SolidColorBrush x:Key="Brush.InputBorderHover" Color="{StaticResource Color.InputBorderHover}" />

</ResourceDictionary>
