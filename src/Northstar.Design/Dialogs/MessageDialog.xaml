<infra:ThemedWindow x:Class="Northstar.Design.Dialogs.MessageDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:infra="clr-namespace:Northstar.Design.Controls"
                   xmlns:icons="clr-namespace:Northstar.Design.Icons"
                   IsDialog="True" Width="480" Title="Message">
  <Grid Margin="24,22,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border x:Name="IconBadge" Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top" Margin="0,0,16,0">
      <icons:GlyphIcon x:Name="Glyph" Width="22" Height="22" AccentOpacity="0" StrokeThickness="1.8" />
    </Border>

    <StackPanel Grid.Column="1">
      <TextBlock x:Name="Heading" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" Margin="0,2,0,6" />
      <TextBlock x:Name="Body" Style="{StaticResource Text.Secondary}" />
    </StackPanel>

    <TextBox x:Name="Details" Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180"
             VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource Font.Mono}" FontSize="12" Visibility="Collapsed" VerticalContentAlignment="Top" />

    <CheckBox x:Name="Option" Grid.Row="2" Grid.Column="1" Margin="0,14,0,0" Visibility="Collapsed" />

    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button x:Name="TertiaryButton" Margin="0,0,8,0" Visibility="Collapsed" Click="OnTertiary" />
      <Button x:Name="SecondaryButton" Margin="0,0,8,0" Visibility="Collapsed" IsCancel="True" Click="OnSecondary" />
      <Button x:Name="PrimaryButton" Style="{StaticResource Button.Accent}" IsDefault="True" Click="OnPrimary" />
    </StackPanel>
  </Grid>
</infra:ThemedWindow>
