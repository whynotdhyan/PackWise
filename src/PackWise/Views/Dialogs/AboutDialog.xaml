<ns:ThemedWindow x:Class="PackWise.Views.Dialogs.AboutDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ns="https://northstarlabs.dev/design"
                   IsDialog="True" Width="460" Title="About PackWise">
  <StackPanel Margin="28,26,28,22">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
      <ns:BrandTile Width="64" Height="64" Margin="0,0,16,0" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="PackWise" Style="{StaticResource Text.Title}" FontSize="24" />
        <TextBlock x:Name="VersionText" Style="{StaticResource Text.Secondary}" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <ns:BrandTile x:Name="StudioMark" Width="18" Height="18" Margin="0,0,6,0" />
          <TextBlock Text="by Northstar Labs" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,0,0,16"
               Text="A free archive manager for Windows: open, create, test and clean up compressed files with safe defaults. No account, no ads, no telemetry, no cloud." />

    <Border Style="{StaticResource Style.Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock x:Name="EngineText" />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                   Text="7-Zip is © Igor Pavlov and licensed under the GNU LGPL with the unRAR restriction. PackWise is not affiliated with 7-Zip, RARLAB or WinRAR." />
      </StackPanel>
    </Border>

    <WrapPanel Margin="0,0,0,18">
      <Button Content="Source code" Style="{StaticResource Button.Link}" Margin="0,0,18,6" Click="OnRepository" />
      <Button Content="Licenses" Style="{StaticResource Button.Link}" Margin="0,0,18,6" Click="OnLicenses" />
      <Button Content="Report a security issue" Style="{StaticResource Button.Link}" Margin="0,0,18,6" Click="OnSecurity" />
    </WrapPanel>

    <Grid>
      <Button x:Name="SupportButton" HorizontalAlignment="Left" Click="OnSupport" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <ns:GlyphIcon Kind="Coffee" Width="16" Height="16" Margin="0,0,8,0" />
          <TextBlock Text="Buy me a coffee" />
        </StackPanel>
      </Button>
      <Button Content="Close" Style="{StaticResource Button.Accent}" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" />
    </Grid>
    <TextBlock Text="Copyright © 2026 Northstar Labs. Released under the MIT License." Style="{StaticResource Text.Caption}" Margin="0,16,0,0" />
  </StackPanel>
</ns:ThemedWindow>
