<ns:ThemedWindow x:Class="PackWise.Views.Dialogs.AddArchiveDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:ns="https://northstarlabs.dev/design"
                   xmlns:vm="clr-namespace:PackWise.ViewModels"
                   mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:AddArchiveViewModel}"
                   IsDialog="True" Width="560" Title="Add to archive">
  <Window.Resources>
    <ns:BoolToVisibilityConverter x:Key="Visible" />
  </Window.Resources>

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
      <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,14,0">
        <ns:GlyphIcon Kind="Add" Width="24" Height="24" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Create an archive" Style="{StaticResource Text.Subtitle}" />
        <TextBlock Text="{Binding SourceSummary}" Style="{StaticResource Text.Caption}" />
      </StackPanel>
    </StackPanel>

    <!-- Name and location -->
    <StackPanel Grid.Row="1" Margin="0,0,0,16">
      <TextBlock Text="Archive" Style="{StaticResource Text.Label}" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="OnBrowse" IsEnabled="{Binding IsAddingToExisting, Converter={StaticResource InverseBool}}" />
        <TextBox x:Name="PathBox" AutomationProperties.Name="Archive path" Text="{Binding ArchivePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsAddingToExisting}" />
      </DockPanel>
    </StackPanel>

    <!-- Format -->
    <StackPanel Grid.Row="2" Margin="0,0,0,16" Visibility="{Binding IsAddingToExisting, Converter={StaticResource Hidden}}">
      <TextBlock Text="Format" Style="{StaticResource Text.Label}" />
      <UniformGrid Columns="2">
        <RadioButton Style="{StaticResource RadioButton.Card}" IsChecked="{Binding IsZip}" Margin="0,0,6,0" AutomationProperties.Name="ZIP format">
          <StackPanel>
            <TextBlock Text="ZIP" FontWeight="SemiBold" />
            <TextBlock Text="Opens almost anywhere" Style="{StaticResource Text.Caption}" />
          </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource RadioButton.Card}" IsChecked="{Binding Is7z}" Margin="6,0,0,0" AutomationProperties.Name="7Z format">
          <StackPanel>
            <TextBlock Text="7Z" FontWeight="SemiBold" />
            <TextBlock Text="Smaller archives" Style="{StaticResource Text.Caption}" />
          </StackPanel>
        </RadioButton>
      </UniformGrid>
      <TextBlock Text="{Binding FormatNote}" Style="{StaticResource Text.Caption}" Margin="2,6,0,0" />
    </StackPanel>

    <!-- Compression -->
    <StackPanel Grid.Row="3" Margin="0,0,0,16" Visibility="{Binding IsAddingToExisting, Converter={StaticResource Hidden}}">
      <TextBlock Text="Compression" Style="{StaticResource Text.Label}" />
      <ComboBox ItemsSource="{Binding Levels}" SelectedValuePath="Level" SelectedValue="{Binding Level}" DisplayMemberPath="Label" />
      <TextBlock Text="{Binding LevelDescription}" Style="{StaticResource Text.Caption}" Margin="2,6,0,0" />
    </StackPanel>

    <!-- Encryption -->
    <Border Grid.Row="4" Style="{StaticResource Style.Card}" Margin="0,0,0,16" Visibility="{Binding IsAddingToExisting, Converter={StaticResource Hidden}}">
      <StackPanel>
        <CheckBox IsChecked="{Binding UsePassword}" AutomationProperties.Name="Protect with a password">
          <StackPanel>
            <TextBlock Text="Protect with a password" FontWeight="SemiBold" />
            <TextBlock Text="{Binding EncryptionNote}" Style="{StaticResource Text.Caption}" />
          </StackPanel>
        </CheckBox>
        <StackPanel Margin="27,12,0,0" Visibility="{Binding UsePassword, Converter={StaticResource Visible}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Password" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
              <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" AutomationProperties.Name="Password" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Confirm password" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
              <PasswordBox x:Name="ConfirmInput" PasswordChanged="OnPasswordChanged" AutomationProperties.Name="Confirm password" />
            </StackPanel>
          </Grid>
          <Grid Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ProgressBar Width="90" Height="4" Maximum="4" Value="{Binding Strength, Mode=OneWay}" Margin="0,0,8,0" />
              <TextBlock Text="{Binding StrengthText}" Style="{StaticResource Text.Caption}" />
            </StackPanel>
            <Button Content="Generate strong password" Style="{StaticResource Button.Link}" HorizontalAlignment="Right" Click="OnGenerate" />
          </Grid>
          <TextBox x:Name="GeneratedBox" IsReadOnly="True" Margin="0,8,0,0" FontFamily="{StaticResource Font.Mono}" Visibility="Collapsed"
                   ToolTip="Copy this password somewhere safe. PackWise can't recover it." />
          <CheckBox Content="Encrypt file names" IsChecked="{Binding EncryptFileNames}" Margin="0,10,0,0"
                    Visibility="{Binding Is7z, Converter={StaticResource Visible}}" />
          <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                     Text="If you forget the password, nobody — including PackWise — can recover the files." />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Footer -->
    <Grid Grid.Row="5">
      <StackPanel VerticalAlignment="Center">
        <CheckBox Content="Test the archive after creating it" IsChecked="{Binding TestAfter}" />
        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource Brush.Danger}" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="300"
                   HorizontalAlignment="Left" Visibility="{Binding ErrorText, Converter={StaticResource Visible}}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
        <Button x:Name="CreateButton" Content="Create" Style="{StaticResource Button.Accent}" IsDefault="True" IsEnabled="{Binding CanCreate}" Click="OnCreate" />
      </StackPanel>
    </Grid>
  </Grid>
</ns:ThemedWindow>
