<ns:ThemedWindow x:Class="PackWise.Views.Dialogs.PasswordDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ns="https://northstarlabs.dev/design"
                   IsDialog="True" Width="440" Title="Password required">
  <StackPanel Margin="24,22,24,20">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
      <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,14,0">
        <ns:GlyphIcon Kind="Lock" Width="22" Height="22" Foreground="{DynamicResource Brush.AccentText}" AccentOpacity="0" />
      </Border>
      <StackPanel VerticalAlignment="Center" MaxWidth="320">
        <TextBlock Text="Enter password" Style="{StaticResource Text.Subtitle}" />
        <TextBlock x:Name="ArchiveName" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      </StackPanel>
    </StackPanel>

    <Border x:Name="RetryBanner" Style="{StaticResource Banner.Danger}" Margin="0,0,0,12" Visibility="Collapsed">
      <TextBlock Text="That password didn't work. Check Caps Lock and try again." TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}" />
    </Border>

    <Grid>
      <PasswordBox x:Name="Secret" Padding="8,6,40,6" PasswordChanged="OnPasswordChanged" />
      <TextBox x:Name="Visible" Padding="8,6,40,6" Visibility="Collapsed" TextChanged="OnVisibleChanged" />
      <ToggleButton x:Name="Reveal" Style="{StaticResource Button.Icon}" Width="28" Height="26" HorizontalAlignment="Right" Margin="0,0,3,0"
                    ToolTip="Show password" Checked="OnRevealChanged" Unchecked="OnRevealChanged">
        <ns:GlyphIcon x:Name="RevealIcon" Kind="Eye" Width="16" Height="16" />
      </ToggleButton>
    </Grid>

    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
               Text="The password stays in memory until PackWise closes. It is never saved or logged." />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
      <Button x:Name="OkButton" Content="OK" Style="{StaticResource Button.Accent}" IsDefault="True" Click="OnOk" IsEnabled="False" />
    </StackPanel>
  </StackPanel>
</ns:ThemedWindow>
