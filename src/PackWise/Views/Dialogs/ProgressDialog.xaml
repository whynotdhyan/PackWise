<ns:ThemedWindow x:Class="PackWise.Views.Dialogs.ProgressDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ns="https://northstarlabs.dev/design"
                   xmlns:vm="clr-namespace:PackWise.ViewModels"
                   d:DataContext="{d:DesignInstance vm:OperationProgress}"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d"
                   IsDialog="True" Width="480" Title="{Binding Title}">
  <StackPanel Margin="24,22,24,20">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,14,0">
        <ns:GlyphIcon Kind="{Binding Icon}" Width="22" Height="22" Foreground="{DynamicResource Brush.AccentText}" />
      </Border>
      <StackPanel VerticalAlignment="Center" Width="370">
        <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Subtitle}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Stage}" Style="{StaticResource Text.Caption}" />
      </StackPanel>
    </StackPanel>

    <TextBlock Text="{Binding CurrentItem}" Style="{StaticResource Text.Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding IsIndeterminate}" />

    <Grid Margin="0,8,0,0">
      <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Left" />
      <TextBlock Text="{Binding TimeText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
    </Grid>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="{Binding CancelText}" IsEnabled="{Binding CanCancel}" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</ns:ThemedWindow>
