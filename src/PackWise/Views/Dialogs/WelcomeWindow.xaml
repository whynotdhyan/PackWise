<ns:ThemedWindow x:Class="PackWise.Views.Dialogs.WelcomeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ns="https://northstarlabs.dev/design"
                 IsDialog="True" Width="760" Title="Getting started with PackWise">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Brand rail -->
    <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
      <DockPanel Margin="28,32,24,24">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
          <ns:BrandTile x:Name="StudioMark" Width="26" Height="26" Margin="0,0,10,0" />
          <TextBlock Text="Northstar Labs" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel>
          <ns:BrandTile Width="72" Height="72" HorizontalAlignment="Left" />
          <TextBlock Text="PackWise" Style="{StaticResource Text.Title}" FontSize="24" Margin="0,16,0,4" />
          <TextBlock Text="Archives, done safely." Style="{StaticResource Text.Secondary}" />
          <ItemsControl x:Name="StepList" Margin="0,28,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Border x:Name="Dot" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Brush.BorderStrong}" Margin="0,0,10,0" />
                  <TextBlock x:Name="Label" Text="{Binding Title}" Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Brush.Accent}" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Step content -->
    <Grid Grid.Column="1" Margin="36,36,32,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel MinHeight="330">
        <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Left">
          <ns:GlyphIcon x:Name="StepIcon" Width="34" Height="34" />
        </Border>
        <TextBlock x:Name="StepTitle" Style="{StaticResource Text.Title}" Margin="0,20,0,10" TextWrapping="Wrap" />
        <TextBlock x:Name="StepBody" Style="{StaticResource Text.Secondary}" FontSize="14" LineHeight="21" />
        <ItemsControl x:Name="StepTips" Margin="0,18,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,0,0,10">
                <ns:GlyphIcon DockPanel.Dock="Left" Kind="Success" Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top"
                              Foreground="{DynamicResource Brush.Accent}" AccentOpacity="0" />
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="StepAction" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" Click="OnStepAction" />
      </StackPanel>

      <Grid Grid.Row="1">
        <Button x:Name="SkipButton" Content="Skip tour" Style="{StaticResource Button.Link}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnSkip" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BackButton" Content="Back" Margin="0,0,8,0" Click="OnBack" />
          <Button x:Name="NextButton" Content="Next" Style="{StaticResource Button.Accent}" IsDefault="True" MinWidth="110" Click="OnNext" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</ns:ThemedWindow>
