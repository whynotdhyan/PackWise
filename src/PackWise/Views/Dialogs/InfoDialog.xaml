<ns:ThemedWindow x:Class="PackWise.Views.Dialogs.InfoDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ns="https://northstarlabs.dev/design"
                   xmlns:icons="clr-namespace:PackWise.Icons"
                   xmlns:dialogs="clr-namespace:PackWise.Views.Dialogs"
                   IsDialog="True" Width="560" Title="Information">
  <Grid Margin="24,22,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,16">
      <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,14,0">
        <icons:FileTypeIcon x:Name="HeaderIcon" Width="28" Height="28" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="Heading" Style="{StaticResource Text.Subtitle}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="SubHeading" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      </StackPanel>
    </DockPanel>

    <ScrollViewer Grid.Row="1" MaxHeight="460" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="Sections">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="dialogs:InfoSection">
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.SectionHeader}" />
              <Border Style="{StaticResource Style.Card}" Padding="14,6">
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="dialogs:InfoRow">
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="170" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock x:Name="Value" Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                          <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                          <Setter TargetName="Value" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsGood}" Value="True">
                          <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button x:Name="ActionButton" Margin="0,0,8,0" Visibility="Collapsed" Click="OnAction" />
      <Button Content="Close" Style="{StaticResource Button.Accent}" IsDefault="True" IsCancel="True" />
    </StackPanel>
  </Grid>
</ns:ThemedWindow>
