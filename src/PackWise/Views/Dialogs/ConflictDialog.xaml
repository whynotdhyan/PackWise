<ns:ThemedWindow x:Class="PackWise.Views.Dialogs.ConflictDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ns="https://northstarlabs.dev/design"
                   IsDialog="True" Width="500" Title="File already exists">
  <StackPanel Margin="24,22,24,20">
    <TextBlock x:Name="Heading" Style="{StaticResource Text.Subtitle}" TextTrimming="CharacterEllipsis" />
    <TextBlock x:Name="TargetPath" Style="{StaticResource Text.Caption}" Margin="0,4,0,16" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Style.Card}">
        <StackPanel>
          <TextBlock Text="ON YOUR PC" Style="{StaticResource Text.SectionHeader}" />
          <TextBlock x:Name="ExistingSize" FontWeight="SemiBold" />
          <TextBlock x:Name="ExistingDate" Style="{StaticResource Text.Secondary}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Style.Card}">
        <StackPanel>
          <TextBlock Text="IN THE ARCHIVE" Style="{StaticResource Text.SectionHeader}" />
          <TextBlock x:Name="IncomingSize" FontWeight="SemiBold" />
          <TextBlock x:Name="IncomingDate" Style="{StaticResource Text.Secondary}" />
        </StackPanel>
      </Border>
    </Grid>

    <TextBlock x:Name="ReplaceNote" Style="{StaticResource Text.Caption}" Margin="0,0,0,12"
               Text="Replaced files go to the Recycle Bin, so you can restore them." />

    <CheckBox x:Name="ApplyToAll" Content="Do the same for every remaining conflict" Margin="0,0,0,4" />

    <Grid Margin="0,20,0,0">
      <Button Content="Stop extraction" Style="{StaticResource Button.Link}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnCancel" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Skip" Margin="0,0,8,0" Click="OnSkip" />
        <Button Content="_Replace" Margin="0,0,8,0" Click="OnReplace" />
        <Button Content="_Keep both" Style="{StaticResource Button.Accent}" IsDefault="True" Click="OnKeepBoth" />
      </StackPanel>
    </Grid>
  </StackPanel>
</ns:ThemedWindow>
