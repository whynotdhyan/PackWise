<ns:ThemedWindow x:Class="PackWise.Views.MainWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:ns="https://northstarlabs.dev/design"
                   xmlns:icons="clr-namespace:PackWise.Icons"
                   xmlns:vm="clr-namespace:PackWise.ViewModels"
                   xmlns:browser="clr-namespace:PackWise.Browser"
                   xmlns:dialogs="clr-namespace:PackWise.Views.Dialogs"
                   xmlns:services="clr-namespace:PackWise.Services"
                   mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}"
                   Title="{Binding WindowTitle}" Width="1180" Height="740" MinWidth="720" MinHeight="420"
                   AllowDrop="True" Icon="/Assets/PackWise.ico">

  <Window.InputBindings>
    <KeyBinding Modifiers="Alt" Key="A" Command="{Binding AddCommand}" />
    <KeyBinding Modifiers="Alt" Key="E" Command="{Binding ExtractCommand}" />
    <KeyBinding Modifiers="Alt" Key="T" Command="{Binding TestCommand}" />
    <KeyBinding Modifiers="Alt" Key="V" Command="{Binding ViewCommand}" />
    <KeyBinding Modifiers="Alt" Key="I" Command="{Binding InfoCommand}" />
    <KeyBinding Modifiers="Alt" Key="Left" Command="{Binding GoBackCommand}" />
    <KeyBinding Modifiers="Alt" Key="Right" Command="{Binding GoForwardCommand}" />
    <KeyBinding Modifiers="Alt" Key="Up" Command="{Binding GoUpCommand}" />
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Modifiers="Control" Key="F" Command="{Binding FocusSearchCommand}" />
    <KeyBinding Key="F3" Command="{Binding FocusSearchCommand}" />
    <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenArchiveFileCommand}" />
    <KeyBinding Modifiers="Control" Key="D" Command="{Binding AddFavoriteCommand}" />
    <KeyBinding Modifiers="Control+Shift" Key="D" Command="{Binding OpenDuplicateFinderCommand}" />
    <KeyBinding Modifiers="Control+Shift" Key="K" Command="{Binding OpenChecksumToolCommand}" />
    <KeyBinding Modifiers="Control+Shift" Key="C" Command="{Binding CopyPathCommand}" />
    <KeyBinding Modifiers="Control" Key="OemComma" Command="{Binding OpenSettingsCommand}" />
    <KeyBinding Key="F9" Command="{Binding ToggleDetailsCommand}" />
    <KeyBinding Key="F1" Command="{Binding ShowWelcomeCommand}" />
  </Window.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Menu -->
    <Border Background="{DynamicResource Brush.Chrome}" Padding="4,2,4,0">
      <Menu>
        <MenuItem Header="_File">
          <MenuItem Header="_Open archive…" InputGestureText="Ctrl+O" Command="{Binding OpenArchiveFileCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="FolderOpen" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="_Recent archives" ItemsSource="{Binding RecentArchives}">
            <MenuItem.ItemContainerStyle>
              <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                <Setter Property="Header" Value="{Binding}" />
                <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Setter Property="CommandParameter" Value="{Binding}" />
              </Style>
            </MenuItem.ItemContainerStyle>
          </MenuItem>
          <MenuItem Header="Clear recent archives" Command="{Binding ClearRecentCommand}" />
          <Separator />
          <MenuItem Header="Copy _path" InputGestureText="Ctrl+Shift+C" Command="{Binding CopyPathCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="Copy" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Show in _Explorer" Command="{Binding RevealInExplorerCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="External" /></MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="E_xit" InputGestureText="Alt+F4" Command="{Binding ExitCommand}" />
        </MenuItem>
        <MenuItem Header="_Commands">
          <MenuItem Header="_Add to archive…" InputGestureText="Alt+A" Command="{Binding AddCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="Add" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="_Extract to…" InputGestureText="Alt+E" Command="{Binding ExtractCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="Extract" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Extract _here" Command="{Binding ExtractHereCommand}" />
          <MenuItem Header="Extract to _named folder" Command="{Binding ExtractToFolderCommand}" />
          <MenuItem Header="C_onvert to ZIP" Command="{Binding ConvertToZipCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="Layers" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Convert to _7Z" Command="{Binding ConvertTo7zCommand}" />
          <MenuItem Header="_Test archive" InputGestureText="Alt+T" Command="{Binding TestCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="Test" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="_View" InputGestureText="Alt+V" Command="{Binding ViewCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="View" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="_Delete" InputGestureText="Del" Command="{Binding DeleteCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="Delete" /></MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="_Find" InputGestureText="Ctrl+F" Command="{Binding FocusSearchCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="Find" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="_Information" InputGestureText="Alt+I" Command="{Binding InfoCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="Info" /></MenuItem.Icon>
          </MenuItem>
        </MenuItem>
        <MenuItem Header="T_ools">
          <MenuItem Header="_Duplicate finder…" InputGestureText="Ctrl+Shift+D" Command="{Binding OpenDuplicateFinderCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="Duplicates" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="_Checksums…" InputGestureText="Ctrl+Shift+K" Command="{Binding OpenChecksumToolCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="Checksum" /></MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="Supported _formats…" Command="{Binding ShowFormatsCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="Layers" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Open _log folder" Command="{Binding OpenLogFolderCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="List" /></MenuItem.Icon>
          </MenuItem>
        </MenuItem>
        <MenuItem Header="Favo_rites">
          <MenuItem Header="_Add this location" InputGestureText="Ctrl+D" Command="{Binding AddFavoriteCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="Star" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="_Go to" ItemsSource="{Binding Favorites}">
            <MenuItem.ItemContainerStyle>
              <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                <Setter Property="Header" Value="{Binding}" />
                <Setter Property="Command" Value="{Binding DataContext.OpenFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Setter Property="CommandParameter" Value="{Binding}" />
              </Style>
            </MenuItem.ItemContainerStyle>
          </MenuItem>
          <MenuItem Header="_Remove" ItemsSource="{Binding Favorites}">
            <MenuItem.ItemContainerStyle>
              <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                <Setter Property="Header" Value="{Binding}" />
                <Setter Property="Command" Value="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Setter Property="CommandParameter" Value="{Binding}" />
              </Style>
            </MenuItem.ItemContainerStyle>
          </MenuItem>
        </MenuItem>
        <MenuItem Header="O_ptions">
          <MenuItem Header="_Theme">
            <MenuItem.Icon><ns:GlyphIcon Kind="Moon" /></MenuItem.Icon>
            <MenuItem Header="Match _Windows" Command="{Binding SetThemeCommand}" CommandParameter="System" IsChecked="{Binding ThemeName, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=System}" />
            <MenuItem Header="_Light" Command="{Binding SetThemeCommand}" CommandParameter="Light" IsChecked="{Binding ThemeName, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Light}" />
            <MenuItem Header="_Dark" Command="{Binding SetThemeCommand}" CommandParameter="Dark" IsChecked="{Binding ThemeName, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Dark}" />
          </MenuItem>
          <MenuItem Header="Details _pane" InputGestureText="F9" IsChecked="{Binding ShowDetails, Mode=OneWay}" Command="{Binding ToggleDetailsCommand}" />
          <Separator />
          <MenuItem Header="_Settings…" InputGestureText="Ctrl+," Command="{Binding OpenSettingsCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="Settings" /></MenuItem.Icon>
          </MenuItem>
        </MenuItem>
        <MenuItem Header="_Help">
          <MenuItem Header="_Getting started" InputGestureText="F1" Command="{Binding ShowWelcomeCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="Sparkle" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="_User guide" Command="{Binding OpenGuideCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="Document" /></MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="_Report a problem" Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static services:AppLinks.Issues}">
            <MenuItem.Icon><ns:GlyphIcon Kind="External" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Report a _security issue" Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static services:AppLinks.SecurityAdvisory}">
            <MenuItem.Icon><ns:GlyphIcon Kind="Shield" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Support Pack_Wise" Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static services:AppLinks.Support}"
                    Visibility="{Binding Source={x:Static services:AppLinks.Support}, Converter={StaticResource Visible}}">
            <MenuItem.Icon><ns:GlyphIcon Kind="Coffee" /></MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="_About PackWise" Command="{Binding ShowAboutCommand}">
            <MenuItem.Icon><ns:GlyphIcon Kind="Info" /></MenuItem.Icon>
          </MenuItem>
        </MenuItem>
      </Menu>
    </Border>

    <!-- Toolbar -->
    <Border Grid.Row="1" Background="{DynamicResource Brush.Chrome}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,4,12,6">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button Style="{StaticResource Button.Toolbar}" AutomationProperties.Name="Add" Command="{Binding AddCommand}" ToolTip="Put the selected files in a new archive (Alt+A)">
            <StackPanel>
              <ns:GlyphIcon Kind="Add" Width="28" Height="28" />
              <TextBlock Text="Add" Margin="0,3,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Toolbar}" AutomationProperties.Name="Extract To" Command="{Binding ExtractCommand}" ToolTip="Extract to a folder you choose (Alt+E)">
            <StackPanel>
              <ns:GlyphIcon Kind="Extract" Width="28" Height="28" />
              <TextBlock Text="Extract To" Margin="0,3,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Toolbar}" AutomationProperties.Name="Test" Command="{Binding TestCommand}" ToolTip="Check every file against its checksum (Alt+T)">
            <StackPanel>
              <ns:GlyphIcon Kind="Test" Width="28" Height="28" />
              <TextBlock Text="Test" Margin="0,3,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Toolbar}" AutomationProperties.Name="View" Command="{Binding ViewCommand}" ToolTip="Open the selected file (Alt+V)">
            <StackPanel>
              <ns:GlyphIcon Kind="View" Width="28" Height="28" />
              <TextBlock Text="View" Margin="0,3,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Toolbar}" AutomationProperties.Name="Delete" Command="{Binding DeleteCommand}" ToolTip="Move to the Recycle Bin, or remove from the archive (Del)">
            <StackPanel>
              <ns:GlyphIcon Kind="Delete" Width="28" Height="28" />
              <TextBlock Text="Delete" Margin="0,3,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="1" Margin="8,8" Background="{DynamicResource Brush.Border}" />
          <Button Style="{StaticResource Button.Toolbar}" AutomationProperties.Name="Find" Command="{Binding FocusSearchCommand}" ToolTip="Find files by name (Ctrl+F)">
            <StackPanel>
              <ns:GlyphIcon Kind="Find" Width="28" Height="28" />
              <TextBlock Text="Find" Margin="0,3,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Toolbar}" AutomationProperties.Name="Info" Command="{Binding InfoCommand}" ToolTip="Archive or file information (Alt+I)">
            <StackPanel>
              <ns:GlyphIcon Kind="Info" Width="28" Height="28" />
              <TextBlock Text="Info" Margin="0,3,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="1" Margin="8,8" Background="{DynamicResource Brush.Border}" />
          <Button Style="{StaticResource Button.Toolbar}" AutomationProperties.Name="Duplicates" Command="{Binding OpenDuplicateFinderCommand}" ToolTip="Find identical files and clean them up safely (Ctrl+Shift+D)">
            <StackPanel>
              <ns:GlyphIcon Kind="Duplicates" Width="28" Height="28" />
              <TextBlock Text="Duplicates" Margin="0,3,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Toolbar}" AutomationProperties.Name="Checksums" Command="{Binding OpenChecksumToolCommand}" ToolTip="Compute or verify CRC32, SHA-256 and SHA-512 (Ctrl+Shift+K)">
            <StackPanel>
              <ns:GlyphIcon Kind="Checksum" Width="28" Height="28" />
              <TextBlock Text="Checksums" Margin="0,3,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="250" Height="32">
            <TextBox x:Name="SearchBox" AutomationProperties.Name="Filter by name" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="30,6,8,6"
                     Tag="Filter by name" ToolTip="Type to filter this folder (Ctrl+F). Esc clears." PreviewKeyDown="OnSearchKeyDown" />
            <ns:GlyphIcon Kind="Find" Width="15" Height="15" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" AccentOpacity="0" />
          </Grid>
          <ToggleButton Style="{StaticResource ToggleButton.Chip}" Margin="8,0,0,0" Height="28" VerticalAlignment="Center" IsChecked="{Binding SearchWholeArchive}" AutomationProperties.Name="Search whole archive" ToolTip="Search every folder in the archive"
                        Visibility="{Binding IsInArchive, Converter={StaticResource Visible}}" Content="Whole archive" />
          <ToggleButton Style="{StaticResource Button.Icon}" Margin="6,0,0,0" IsChecked="{Binding ShowDetails, Mode=OneWay}" Command="{Binding ToggleDetailsCommand}"
                        AutomationProperties.Name="Details pane" ToolTip="Details pane (F9)">
            <ns:GlyphIcon Kind="Document" Width="18" Height="18" />
          </ToggleButton>
          <Button Style="{StaticResource Button.Icon}" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Settings" ToolTip="Settings (Ctrl+,)" Margin="2,0,0,0">
            <ns:GlyphIcon Kind="Settings" Width="18" Height="18" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Address row -->
    <Border Grid.Row="2" Background="{DynamicResource Brush.Window}" Padding="8,7,12,7">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,8,0">
          <Button Style="{StaticResource Button.Icon}" Command="{Binding GoBackCommand}" AutomationProperties.Name="Back" ToolTip="Back (Alt+Left)">
            <ns:GlyphIcon Kind="Back" Width="16" Height="16" />
          </Button>
          <Button Style="{StaticResource Button.Icon}" Command="{Binding GoForwardCommand}" AutomationProperties.Name="Forward" ToolTip="Forward (Alt+Right)">
            <ns:GlyphIcon Kind="Forward" Width="16" Height="16" />
          </Button>
          <Button Style="{StaticResource Button.Icon}" Command="{Binding GoUpCommand}" AutomationProperties.Name="Up one level" ToolTip="Up one level (Backspace)">
            <ns:GlyphIcon Kind="Up" Width="16" Height="16" />
          </Button>
        </StackPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh" ToolTip="Refresh (F5)" Margin="6,0,0,0">
          <ns:GlyphIcon Kind="Refresh" Width="16" Height="16" />
        </Button>

        <Grid>
          <Border x:Name="CrumbBar" Background="{DynamicResource Brush.InputBackground}" BorderBrush="{DynamicResource Brush.InputBorder}" BorderThickness="1"
                  CornerRadius="{StaticResource Radius.Control}" MinHeight="32" Cursor="IBeam" MouseLeftButtonUp="OnCrumbBarClick">
            <DockPanel Margin="6,0">
              <ns:GlyphIcon x:Name="LocationIcon" DockPanel.Dock="Left" Kind="Folder" Width="16" Height="16" Margin="2,0,6,0" />
              <ScrollViewer x:Name="CrumbScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Cursor="Arrow">
                <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="browser:Breadcrumb">
                      <StackPanel Orientation="Horizontal">
                        <ns:GlyphIcon x:Name="Chevron" Kind="ChevronRight" Width="12" Height="12" Margin="1,0" AccentOpacity="0"
                                         Foreground="{DynamicResource Brush.TextTertiary}" />
                        <Button x:Name="Crumb" Style="{StaticResource Button.Ghost}" Padding="6,4" Click="OnCrumbClick" AutomationProperties.Name="{Binding Label}">
                          <StackPanel Orientation="Horizontal">
                            <ns:GlyphIcon x:Name="ArchiveMark" Kind="Archive" Width="13" Height="13" Margin="0,0,5,0" Visibility="Collapsed" />
                            <TextBlock Text="{Binding Label}" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                          <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsArchive}" Value="True">
                          <Setter TargetName="Crumb" Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>
          <TextBox x:Name="AddressBox" AutomationProperties.Name="Address" Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed"
                   PreviewKeyDown="OnAddressKeyDown" LostKeyboardFocus="OnAddressLostFocus" />
        </Grid>
      </DockPanel>
    </Border>

    <!-- Notice banner -->
    <Border Grid.Row="3" Margin="12,0,12,8" CornerRadius="6" Padding="12,8"
            Visibility="{Binding Banner, Converter={StaticResource Visible}}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{DynamicResource Brush.InfoSoft}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Banner.Kind}" Value="Success">
              <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Banner.Kind}" Value="Warning">
              <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Banner.Kind}" Value="Danger">
              <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel>
        <ns:GlyphIcon DockPanel.Dock="Left" Width="17" Height="17" Margin="0,0,10,0" AccentOpacity="0">
          <ns:GlyphIcon.Style>
            <Style TargetType="ns:GlyphIcon">
              <Setter Property="Kind" Value="Info" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Info}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Banner.Kind}" Value="Success">
                  <Setter Property="Kind" Value="Success" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Banner.Kind}" Value="Warning">
                  <Setter Property="Kind" Value="Warning" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Banner.Kind}" Value="Danger">
                  <Setter Property="Kind" Value="Error" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ns:GlyphIcon.Style>
        </ns:GlyphIcon>
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Width="26" Height="26" Command="{Binding DismissBannerCommand}" AutomationProperties.Name="Dismiss" ToolTip="Dismiss">
          <ns:GlyphIcon Kind="Close" Width="12" Height="12" />
        </Button>
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Margin="12,0" VerticalAlignment="Center" Content="{Binding Banner.ActionText}"
                Command="{Binding RunBannerActionCommand}" Visibility="{Binding Banner.ActionText, Converter={StaticResource Visible}}" />
        <TextBlock Text="{Binding Banner.Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Row="4" Margin="12,0,12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition x:Name="SplitterColumn" Width="10" />
        <ColumnDefinition x:Name="DetailsColumn" Width="300" MinWidth="220" MaxWidth="560" />
      </Grid.ColumnDefinitions>

      <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="4,2,2,4">
        <Grid>
          <ListView x:Name="FileList" ItemsSource="{Binding Items}" SelectionMode="Extended" Background="Transparent" SizeChanged="OnListSizeChanged"
                    MouseDoubleClick="OnListDoubleClick" PreviewKeyDown="OnListKeyDown" SelectionChanged="OnListSelectionChanged"
                    AutomationProperties.Name="Files">
            <ListView.View>
              <GridView x:Name="Columns" AllowsColumnReorder="True" ColumnHeaderContainerStyle="{StaticResource GridView.Header}" />
            </ListView.View>
            <ListView.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="_Open" FontWeight="SemiBold" Command="{Binding ViewCommand}" />
                <Separator />
                <MenuItem Header="_Extract to…" Command="{Binding ExtractCommand}">
                  <MenuItem.Icon><ns:GlyphIcon Kind="Extract" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Extract _here" Command="{Binding ExtractHereCommand}" />
                <MenuItem Header="Extract to _named folder" Command="{Binding ExtractToFolderCommand}" />
                <MenuItem Header="_Test" Command="{Binding TestCommand}">
                  <MenuItem.Icon><ns:GlyphIcon Kind="Test" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Add to archive…" Command="{Binding AddCommand}" Visibility="{Binding IsInArchive, Converter={StaticResource Hidden}}">
                  <MenuItem.Icon><ns:GlyphIcon Kind="Add" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Quick _ZIP next to it" Command="{Binding QuickZipCommand}" Visibility="{Binding IsInArchive, Converter={StaticResource Hidden}}" />
                <MenuItem Header="Con_vert to ZIP" Command="{Binding ConvertToZipCommand}">
                  <MenuItem.Icon><ns:GlyphIcon Kind="Layers" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Convert to 7Z" Command="{Binding ConvertTo7zCommand}" />
                <MenuItem Header="C_hecksums…" Command="{Binding OpenChecksumToolCommand}" Visibility="{Binding IsInArchive, Converter={StaticResource Hidden}}">
                  <MenuItem.Icon><ns:GlyphIcon Kind="Checksum" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Find _duplicates here" Command="{Binding OpenDuplicateFinderCommand}" Visibility="{Binding IsInArchive, Converter={StaticResource Hidden}}">
                  <MenuItem.Icon><ns:GlyphIcon Kind="Duplicates" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Copy _path" Command="{Binding CopyPathCommand}">
                  <MenuItem.Icon><ns:GlyphIcon Kind="Copy" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Show in E_xplorer" Command="{Binding RevealInExplorerCommand}">
                  <MenuItem.Icon><ns:GlyphIcon Kind="External" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Delete" Command="{Binding DeleteCommand}">
                  <MenuItem.Icon><ns:GlyphIcon Kind="Delete" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Information" Command="{Binding InfoCommand}">
                  <MenuItem.Icon><ns:GlyphIcon Kind="Info" /></MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </ListView.ContextMenu>
          </ListView>

          <!-- Empty folder hint -->
          <TextBlock x:Name="EmptyHint" Text="Nothing here. Drop files to create an archive." HorizontalAlignment="Center" VerticalAlignment="Center"
                     Style="{StaticResource Text.Caption}" FontSize="13" Visibility="Collapsed" IsHitTestVisible="False" />

          <!-- Busy overlay -->
          <Border Background="{DynamicResource Brush.Surface}" Opacity="0.92" CornerRadius="{StaticResource Radius.Card}"
                  Visibility="{Binding IsBusy, Converter={StaticResource Visible}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="260">
              <TextBlock Text="{Binding BusyText}" HorizontalAlignment="Center" Margin="0,0,0,10" />
              <ProgressBar IsIndeterminate="True" />
            </StackPanel>
          </Border>

          <!-- Drop hint -->
          <Border x:Name="DropHint" Background="{DynamicResource Brush.AccentSoftHover}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="2"
                  CornerRadius="{StaticResource Radius.Card}" Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <ns:GlyphIcon Kind="Add" Width="44" Height="44" HorizontalAlignment="Center" />
              <TextBlock x:Name="DropHintText" Style="{StaticResource Text.Subtitle}" Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <GridSplitter x:Name="DetailsSplitter" Grid.Column="1" Width="10" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Focusable="False" />

      <!-- Details pane -->
      <Border x:Name="DetailsPane" Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
              CornerRadius="{StaticResource Radius.Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,18,14,18">
          <StackPanel>
            <icons:FileTypeIcon Kind="{Binding DetailsKind}" Width="52" Height="52" HorizontalAlignment="Left" Margin="0,0,0,12" />
            <TextBlock Text="{Binding DetailsTitle}" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DetailsSubtitle}" Style="{StaticResource Text.Caption}" Margin="0,2,0,14" />

            <Border Style="{StaticResource Banner.Warning}" Margin="0,0,0,14" Visibility="{Binding DetailsWarning, Converter={StaticResource Visible}}">
              <DockPanel>
                <ns:GlyphIcon Kind="Warning" Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top" AccentOpacity="0"
                                 Foreground="{DynamicResource Brush.Warning}" />
                <TextBlock Text="{Binding DetailsWarning}" TextWrapping="Wrap" />
              </DockPanel>
            </Border>

            <Border CornerRadius="6" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    Margin="0,0,0,14" Visibility="{Binding PreviewImage, Converter={StaticResource Visible}}" Padding="6">
              <Image Source="{Binding PreviewImage}" MaxHeight="240" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource Font.Mono}" FontSize="11.5"
                     MaxHeight="260" VerticalContentAlignment="Top" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled"
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,14" Visibility="{Binding PreviewText, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding PreviewNote}" Style="{StaticResource Text.Caption}" Margin="0,0,0,14"
                       Visibility="{Binding PreviewNote, Converter={StaticResource Visible}}" />

            <ItemsControl ItemsSource="{Binding DetailsRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="dialogs:InfoRow">
                  <StackPanel Margin="0,0,0,11">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" />
                    <TextBlock x:Name="Value" Text="{Binding Value}" TextWrapping="Wrap" Margin="0,1,0,0" />
                  </StackPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                      <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="5" Padding="14,6,14,7" Margin="0,6,0,0" Background="{DynamicResource Brush.Chrome}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Border Style="{StaticResource Banner.Info}" Padding="7,2" Margin="6,0,0,0" Visibility="{Binding FormatBadge, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal">
              <ns:GlyphIcon Kind="Archive" Width="13" Height="13" Margin="0,0,5,0" />
              <TextBlock Text="{Binding FormatBadge}" FontSize="{StaticResource Font.Size.Small}" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="6" Padding="7,2" Margin="6,0,0,0" Visibility="{Binding ArchiveEncrypted, Converter={StaticResource Visible}}"
                  ToolTip="Some or all of this archive is encrypted">
            <StackPanel Orientation="Horizontal">
              <ns:GlyphIcon Kind="Lock" Width="13" Height="13" Margin="0,0,5,0" />
              <TextBlock Text="Encrypted" FontSize="{StaticResource Font.Size.Small}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Banner.Warning}" Padding="7,2" Margin="6,0,0,0" Visibility="{Binding ArchiveFromInternet, Converter={StaticResource Visible}}"
                  ToolTip="Downloaded from the internet. Extracted files keep this mark so Windows can warn before opening them.">
            <StackPanel Orientation="Horizontal">
              <ns:GlyphIcon Kind="Globe" Width="13" Height="13" Margin="0,0,5,0" />
              <TextBlock Text="From the internet" FontSize="{StaticResource Font.Size.Small}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Banner.Danger}" Padding="7,2" Margin="6,0,0,0" Visibility="{Binding ArchiveHasIssues, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal">
              <ns:GlyphIcon Kind="Warning" Width="13" Height="13" Margin="0,0,5,0" />
              <TextBlock Text="Damaged" FontSize="{StaticResource Font.Size.Small}" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding TotalText}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{StaticResource Font.Size.Small}" />
          <TextBlock Text="  ·  " Foreground="{DynamicResource Brush.TextTertiary}" FontSize="{StaticResource Font.Size.Small}"
                     Visibility="{Binding SelectionText, Converter={StaticResource Visible}}" />
          <TextBlock Text="{Binding SelectionText}" Foreground="{DynamicResource Brush.Text}" FontSize="{StaticResource Font.Size.Small}" FontWeight="SemiBold" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</ns:ThemedWindow>
