<ns:ThemedWindow x:Class="PackWise.Views.Tools.DuplicateFinderWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:ns="https://northstarlabs.dev/design"
                   xmlns:icons="clr-namespace:PackWise.Icons"
                   xmlns:vm="clr-namespace:PackWise.ViewModels"
                   mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:DuplicateFinderViewModel}"
                   Title="Duplicate finder - PackWise" Width="1120" Height="720" MinWidth="820" MinHeight="480"
                   WindowStartupLocation="CenterOwner" Icon="/Assets/PackWise.ico" AllowDrop="True">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Scan setup -->
    <Border Style="{StaticResource Style.Card}" Background="{DynamicResource Brush.Surface}" Padding="16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <ns:GlyphIcon Kind="Duplicates" Width="26" Height="26" Margin="0,0,10,0" />
            <TextBlock Text="Duplicate finder" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,14"
                     Text="Finds files with identical contents, whatever their names. Nothing is deleted without your say, and everything goes to the Recycle Bin." />
          <TextBlock Text="FOLDERS TO SCAN" Style="{StaticResource Text.SectionHeader}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <Button Content="Add folder…" Command="{Binding AddFolderCommand}" HorizontalAlignment="Left" Margin="0,8,0,16" />

          <TextBlock Text="OPTIONS" Style="{StaticResource Text.SectionHeader}" />
          <ComboBox ItemsSource="{Binding SizeOptions}" SelectedItem="{Binding MinimumSize}" DisplayMemberPath="Label" Margin="0,0,0,10" />
          <CheckBox Content="Skip online-only cloud files" IsChecked="{Binding SkipCloudFiles}" Margin="0,0,0,8"
                    ToolTip="OneDrive and similar placeholders would be downloaded if read. Leave this on to avoid surprise downloads." />
          <CheckBox Content="Compare byte by byte" IsChecked="{Binding VerifyBytes}" Margin="0,0,0,8"
                    ToolTip="Slower. Confirms SHA-256 matches by comparing every byte." />
          <CheckBox Content="Include hidden files" IsChecked="{Binding IncludeHidden}" Margin="0,0,0,8" />
          <CheckBox Content="Include Windows and program folders" IsChecked="{Binding IncludeSystemFolders}" Margin="0,0,0,18"
                    ToolTip="Not recommended. Files there are often needed in more than one place." />

          <Grid>
            <Button Content="Scan for duplicates" Style="{StaticResource Button.Accent}" Command="{Binding ScanCommand}" HorizontalAlignment="Stretch" MinHeight="36"
                    Visibility="{Binding IsScanning, Converter={StaticResource Hidden}}" />
            <Button Content="Stop scan" Command="{Binding CancelScanCommand}" HorizontalAlignment="Stretch" MinHeight="36"
                    Visibility="{Binding IsScanning, Converter={StaticResource Visible}}" />
          </Grid>
          <ProgressBar Margin="0,12,0,6" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate}"
                       Visibility="{Binding IsScanning, Converter={StaticResource Visible}}" />
          <TextBlock Text="{Binding StageText}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Folders}" MinHeight="70">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Width="22" Height="22" ToolTip="Remove"
                        Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                  <ns:GlyphIcon Kind="Close" Width="10" Height="10" />
                </Button>
                <icons:FileTypeIcon Kind="Folder" Width="16" Height="16" Margin="0,0,8,0" />
                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" VerticalAlignment="Center" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Results -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <UniformGrid Columns="3" Margin="0,0,0,12">
        <Border Style="{StaticResource Style.Card}" Margin="0,0,6,0" Background="{DynamicResource Brush.Surface}">
          <StackPanel>
            <TextBlock Text="DUPLICATE GROUPS" Style="{StaticResource Text.SectionHeader}" Margin="0,0,0,2" />
            <TextBlock Text="{Binding GroupCountText}" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource Font.Display}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Style.Card}" Margin="6,0" Background="{DynamicResource Brush.Surface}">
          <StackPanel>
            <TextBlock Text="FILES INVOLVED" Style="{StaticResource Text.SectionHeader}" Margin="0,0,0,2" />
            <TextBlock Text="{Binding FileCountText}" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource Font.Display}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Style.Card}" Margin="6,0,0,0" Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.AccentSoft}">
          <StackPanel>
            <TextBlock Text="SPACE YOU COULD FREE" Style="{StaticResource Text.SectionHeader}" Margin="0,0,0,2" />
            <TextBlock Text="{Binding ReclaimableText}" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource Font.Display}" Foreground="{DynamicResource Brush.AccentText}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <DockPanel Grid.Row="1" Margin="0,0,0,10">
        <TextBlock DockPanel.Dock="Left" Text="Select all but:" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,8,0" />
        <Button DockPanel.Dock="Left" Content="Newest" Command="{Binding SelectKeepingCommand}" CommandParameter="Newest" MinWidth="0" Margin="0,0,6,0" ToolTip="Keep the most recently modified copy in each group" />
        <Button DockPanel.Dock="Left" Content="Oldest" Command="{Binding SelectKeepingCommand}" CommandParameter="Oldest" MinWidth="0" Margin="0,0,6,0" ToolTip="Keep the original (oldest) copy in each group" />
        <Button DockPanel.Dock="Left" Content="Shortest path" Command="{Binding SelectKeepingCommand}" CommandParameter="ShortestPath" MinWidth="0" Margin="0,0,6,0" />
        <Button DockPanel.Dock="Left" Content="In first folder" Command="{Binding SelectKeepingCommand}" CommandParameter="InPreferredFolder" MinWidth="0" Margin="0,0,6,0"
                ToolTip="Keep the copy inside the first folder in the list" />
        <Button DockPanel.Dock="Left" Content="Clear" Style="{StaticResource Button.Link}" Command="{Binding ClearSelectionCommand}" VerticalAlignment="Center" Margin="8,0,0,0" />
        <Grid DockPanel.Dock="Right" Width="200" HorizontalAlignment="Right">
          <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Tag="Filter by name" Padding="28,5,8,5" MinHeight="30" />
          <ns:GlyphIcon Kind="Find" Width="14" Height="14" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False" AccentOpacity="0" />
        </Grid>
      </DockPanel>

      <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="4">
        <Grid>
          <ListView x:Name="ResultList" ItemsSource="{Binding Rows}" SelectionMode="Extended" Background="Transparent"
                    VirtualizingPanel.IsVirtualizingWhenGrouping="True" MouseDoubleClick="OnRowDoubleClick" KeyDown="OnListKeyDown">
            <ListView.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <Border Margin="0,10,0,2" Padding="8,4">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name.Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Name.Detail}" Foreground="{DynamicResource Brush.TextTertiary}" Margin="12,0,0,0" FontSize="{StaticResource Font.Size.Small}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListView.GroupStyle>
            <ListView.View>
              <GridView ColumnHeaderContainerStyle="{StaticResource GridView.Header}">
                <GridViewColumn Width="36">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="vm:DuplicateRow">
                      <CheckBox IsChecked="{Binding IsMarked}" Margin="6,0,0,0" ToolTip="Select for clean-up" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Name" Width="200">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="vm:DuplicateRow">
                      <StackPanel Orientation="Horizontal">
                        <icons:FileTypeIcon Kind="{Binding Kind}" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text=" (hard link)" Foreground="{DynamicResource Brush.TextTertiary}" Visibility="{Binding IsHardLink, Converter={StaticResource Visible}}"
                                   ToolTip="Same physical file as another entry; removing it frees no space." />
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Folder" Width="280">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="vm:DuplicateRow">
                      <TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullFolder}" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Size" Width="80">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="vm:DuplicateRow">
                      <TextBlock Text="{Binding SizeText}" TextAlignment="Right" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Modified" Width="130">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="vm:DuplicateRow">
                      <TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
            <ListView.ContextMenu>
              <ContextMenu>
                <MenuItem Header="_Open" Click="OnOpenFile" />
                <MenuItem Header="Show in _Explorer" Click="OnRevealFile">
                  <MenuItem.Icon><ns:GlyphIcon Kind="External" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Mark selected rows" Click="OnMarkSelected" />
                <MenuItem Header="_Unmark selected rows" Click="OnUnmarkSelected" />
              </ContextMenu>
            </ListView.ContextMenu>
          </ListView>

          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasResults, Converter={StaticResource Hidden}}" IsHitTestVisible="False">
            <ns:GlyphIcon Kind="Duplicates" Width="48" Height="48" HorizontalAlignment="Center" Opacity="0.6" />
            <TextBlock Text="{Binding StageText}" Style="{StaticResource Text.Secondary}" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Actions -->
      <Grid Grid.Row="3" Margin="0,12,0,0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding MarkedText}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ResultMessage}" Style="{StaticResource Text.Caption}" Visibility="{Binding ResultMessage, Converter={StaticResource Visible}}" />
          <TextBlock Text="{Binding ScanNote}" Style="{StaticResource Text.Caption}" Visibility="{Binding ScanNote, Converter={StaticResource Visible}}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Move to review folder…" Command="{Binding MoveToReviewCommand}" Margin="0,0,8,0"
                  ToolTip="Move the selected files into a folder you choose, keeping their original paths so you can put them back" />
          <Button Style="{StaticResource Button.Accent}" Command="{Binding RecycleCommand}" ToolTip="Recoverable from the Recycle Bin">
            <StackPanel Orientation="Horizontal">
              <ns:GlyphIcon Kind="Recycle" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource Brush.TextOnAccent}" AccentOpacity="0" />
              <TextBlock Text="Move to Recycle Bin" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</ns:ThemedWindow>
