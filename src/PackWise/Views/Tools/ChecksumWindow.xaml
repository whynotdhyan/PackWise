<ns:ThemedWindow x:Class="PackWise.Views.Tools.ChecksumWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:ns="https://northstarlabs.dev/design"
                   xmlns:icons="clr-namespace:PackWise.Icons"
                   xmlns:vm="clr-namespace:PackWise.ViewModels"
                   mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ChecksumViewModel}"
                   Title="Checksums - PackWise" Width="980" Height="600" MinWidth="720" MinHeight="420"
                   WindowStartupLocation="CenterOwner" Icon="/Assets/PackWise.ico" AllowDrop="True">
  <Grid Margin="20,14,20,18">
    <TabControl>
      <TabItem Header="Compute">
        <Grid Margin="0,14,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
              <Button Content="Add files…" Click="OnAddFiles" Margin="0,0,8,0" />
              <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,20,0" />
              <CheckBox Content="CRC32" IsChecked="{Binding UseCrc32}" VerticalAlignment="Center" Margin="0,0,16,0" />
              <CheckBox Content="SHA-256" IsChecked="{Binding UseSha256}" VerticalAlignment="Center" Margin="0,0,16,0" />
              <CheckBox Content="SHA-512" IsChecked="{Binding UseSha512}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Save checksum file…" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
              <Button Content="Compute" Style="{StaticResource Button.Accent}" Command="{Binding ComputeCommand}"
                      Visibility="{Binding IsWorking, Converter={StaticResource Hidden}}" />
              <Button Content="Stop" Command="{Binding CancelCommand}" Visibility="{Binding IsWorking, Converter={StaticResource Visible}}" />
            </StackPanel>
          </DockPanel>

          <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="4">
            <Grid>
              <ListView x:Name="ResultList" ItemsSource="{Binding Rows}" Background="Transparent">
                <ListView.View>
                  <GridView x:Name="ComputeColumns" ColumnHeaderContainerStyle="{StaticResource GridView.Header}">
                    <GridViewColumn Header="File" Width="200">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="vm:ChecksumRow">
                          <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                            <icons:FileTypeIcon Kind="{Binding Kind}" Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock x:Name="Name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMatch}" Value="True">
                              <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                              <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding SizeText}" />
                    <GridViewColumn x:Name="CrcColumn" Header="CRC32" Width="90">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="vm:ChecksumRow">
                          <TextBlock Text="{Binding Crc32}" FontFamily="{StaticResource Font.Mono}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Crc32}" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="Sha256Column" Header="SHA-256" Width="470">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="vm:ChecksumRow">
                          <TextBlock Text="{Binding Sha256}" FontFamily="{StaticResource Font.Mono}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Sha256}" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="Sha512Column" Header="SHA-512" Width="480">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="vm:ChecksumRow">
                          <TextBlock Text="{Binding Sha512}" FontFamily="{StaticResource Font.Mono}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Sha512}" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Status" Width="70" DisplayMemberBinding="{Binding Status}" />
                  </GridView>
                </ListView.View>
                <ListView.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy SHA-256" Click="OnCopySha256" />
                    <MenuItem Header="Copy CRC32" Click="OnCopyCrc" />
                    <MenuItem Header="Copy SHA-512" Click="OnCopySha512" />
                  </ContextMenu>
                </ListView.ContextMenu>
              </ListView>
              <TextBlock Text="Drop files here or use Add files." Style="{StaticResource Text.Caption}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsHitTestVisible="False" Visibility="{Binding Rows.Count, Converter={StaticResource Hidden}}" />
            </Grid>
          </Border>

          <ProgressBar Grid.Row="2" Margin="0,10,0,0" Value="{Binding ProgressValue, Mode=OneWay}" Visibility="{Binding IsWorking, Converter={StaticResource Visible}}" />

          <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Compare with:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource Brush.TextSecondary}" />
            <TextBox Grid.Column="1" Text="{Binding CompareText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}"
                     Tag="Paste a published CRC32, SHA-256 or SHA-512 value to check it" />
            <TextBlock Grid.Column="2" Text="{Binding CompareResult}" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="280" TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CompareMatched}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CompareMatched}" Value="False">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Verify a checksum file">
        <Grid Margin="0,14,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Left" Content="Open .sha256 / .sha512 / .sfv…" Click="OnOpenChecksumFile" Style="{StaticResource Button.Accent}" />
            <TextBlock Text="{Binding VerifySummary}" VerticalAlignment="Center" Margin="14,0,0,0" Style="{StaticResource Text.Secondary}" />
          </DockPanel>
          <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="4">
            <ListView ItemsSource="{Binding VerifyRows}" Background="Transparent">
              <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource GridView.Header}">
                  <GridViewColumn Header="File" Width="280">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="vm:VerifyRow">
                        <StackPanel Orientation="Horizontal">
                          <ns:GlyphIcon x:Name="Mark" Kind="Error" Width="16" Height="16" Margin="0,0,8,0" AccentOpacity="0" Foreground="{DynamicResource Brush.Danger}" />
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsOk}" Value="True">
                            <Setter TargetName="Mark" Property="Kind" Value="Success" />
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Result" Width="260" DisplayMemberBinding="{Binding ResultText}" />
                  <GridViewColumn Header="Expected" Width="320">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="vm:VerifyRow">
                        <TextBlock Text="{Binding Expected}" FontFamily="{StaticResource Font.Mono}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextSecondary}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,0,0" />
  </Grid>
</ns:ThemedWindow>
